# Windows batch files MUST use CRLF — cmd parses LF-only .bat
# files inconsistently and aborts on multi-line for/if blocks.
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Unix shell scripts must stay LF
*.sh    text eol=lf

# Build config — LF on all platforms
*.gradle      text eol=lf
*.properties  text eol=lf
*.toml        text eol=lf
*.json        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.java        text eol=lf
*.md          text eol=lf

# Binary
*.png   binary
*.jar   binary
